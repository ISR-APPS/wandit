{
	"cli": {
		"version": ">= 24.8.0",
		"appVersionSource": "remote"
	},
	"build": {
		"apk": {
			"distribution": "internal",
			"autoIncrement": true,
			"android": {
				"buildType": "apk"
			}
		},
		"ios-store": {
			"distribution": "store",
			"autoIncrement": true
		},
		"ios-simulator": {
			"ios": {
				"simulator": true
			}
		}
	}
}
