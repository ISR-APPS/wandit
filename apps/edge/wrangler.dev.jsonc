{
	// Local-dev twin of wrangler.jsonc. Two intended deltas. No "routes":
	// with a zone route configured, `wrangler dev` (4.114) fails every local
	// request with an opaque internal error. No "dispatch_namespaces": no
	// user Worker runs locally, so a `kind: "app"` pointer answers the 500
	// page. Keep every other field in lockstep with wrangler.jsonc.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wandit-edge",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-11",
	// @sentry/cloudflare needs AsyncLocalStorage; nodejs_als is the minimal flag.
	"compatibility_flags": ["nodejs_als"],
	// Lets the Sentry SDK auto-derive the release from the Worker version.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"upload_source_maps": true,
	// No SENTRY_DSN locally — Sentry stays disabled in dev.
	"vars": { "SENTRY_ENVIRONMENT": "development" },
	"kv_namespaces": [{ "binding": "PTR", "id": "TODO-kv-namespace-id" }],
	"r2_buckets": [{ "binding": "SITES", "bucket_name": "wandit-pages-dev" }],
	"observability": { "enabled": true }
}
