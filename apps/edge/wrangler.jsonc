{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wandit-edge",
	"main": "src/index.ts",
	"account_id": "6b421048e434497bce142970530e4eb1",
	"compatibility_date": "2025-10-11",
	// One route catches every request entering the wandit.app zone — including
	// Cloudflare-for-SaaS custom hostnames (their Host header is the customer
	// domain, so a *.wandit.app pattern would MISS them). The app hostnames
	// (wandit.app, www, api) must additionally get dashboard route exclusions
	// (more-specific routes assigned to Worker "None") — see
	// docs/features/edge-serving.md.
	"routes": [{ "pattern": "*/*", "zone_name": "wandit.app" }],
	// Pointer namespace. Key: `domain:{host}` (see
	// apps/server/src/modules/domains/infrastructure/cloudflare/domain-routing.service.ts).
	// Fill the real namespace id (CLOUDFLARE_KV_NAMESPACE_ID) at deploy time;
	// local dev and tests simulate the binding and ignore the id.
	"kv_namespaces": [{ "binding": "PTR", "id": "10d1db8c7def488ba5397727c1e4ef6d" }],
	// Published bytes live in the same bucket the API writes:
	// published/{projectId}/current.html (see r2.ts publishedCurrentKey).
	"r2_buckets": [{ "binding": "SITES", "bucket_name": "wandit-pages-dev" }],
	// Deliberately NOT enabling the new Workers Cache ("cache": {...}): it is
	// host-blind (same path on different customer domains shares one entry),
	// which for multi-tenant serving means cross-tenant content leaks. We use
	// the legacy caches.default API instead — it keys on the full URL
	// including host. Do not flip this on without the ctx.props two-entrypoint
	// design described in docs/features/edge-serving.md.
	"observability": { "enabled": true }
}
