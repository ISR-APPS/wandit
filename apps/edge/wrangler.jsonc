{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wandit-edge",
	"main": "src/index.ts",
	"account_id": "6b421048e434497bce142970530e4eb1",
	"compatibility_date": "2025-10-11",
	// @sentry/cloudflare needs AsyncLocalStorage; nodejs_als is the minimal flag.
	"compatibility_flags": ["nodejs_als"],
	// Lets the Sentry SDK auto-derive the release from the Worker version.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// Uploads maps to CLOUDFLARE (Workers Logs / dashboard stack mapping).
	// Sentry needs its own artifact upload (sentry-cli) — a later increment;
	// until then wandit-edge stacks in Sentry show bundled positions.
	"upload_source_maps": true,
	// SENTRY_DSN is intentionally NOT here — set it as a Worker secret per
	// environment (`wrangler secret put SENTRY_DSN --env <env>`). Unset =
	// Sentry disabled.
	"vars": { "SENTRY_ENVIRONMENT": "production" },
	// Pointer namespace. Key: `domain:{host}` (see
	// apps/server/src/modules/domains/infrastructure/cloudflare/domain-routing.service.ts).
	// Fill the real namespace id (CLOUDFLARE_KV_NAMESPACE_ID) at deploy time;
	// local dev and tests simulate the binding and ignore the id.
	"kv_namespaces": [{ "binding": "PTR", "id": "10d1db8c7def488ba5397727c1e4ef6d" }],
	// Published bytes live in the same bucket the production API writes
	// (R2_BUCKET): published/{projectId}/current.html (see r2.ts
	// publishedCurrentKey). Staging and local dev use their own buckets,
	// which this deployed worker deliberately does not serve.
	"r2_buckets": [{ "binding": "SITES", "bucket_name": "wandit-production" }],
	// Workers for Platforms namespace of the V2 user Workers: one script per
	// app, named appWorkerName(projectId). A real deploy fails when the
	// namespace does not exist in the account; a dry run does not check it.
	"dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "production" }],
	// Deliberately NOT enabling the new Workers Cache ("cache": {...}): it is
	// host-blind (same path on different customer domains shares one entry),
	// which for multi-tenant serving means cross-tenant content leaks. We use
	// the legacy caches.default API instead — it keys on the full URL
	// including host. Do not flip this on without the ctx.props two-entrypoint
	// design described in docs/features/edge-serving.md.
	"observability": { "enabled": true },
	// vars, kv_namespaces, r2_buckets, dispatch_namespaces, and
	// version_metadata are NOT inherited by an environment block; repeat each
	// one in every env. routes IS inherited, so it lives in env.production
	// only — the staging Worker must never take the */* route on wandit.app.
	"env": {
		"production": {
			// Without name, wrangler names the Worker wandit-edge-production.
			"name": "wandit-edge",
			// One route catches every request entering the wandit.app zone —
			// including Cloudflare-for-SaaS custom hostnames (their Host
			// header is the customer domain, so a *.wandit.app pattern would
			// MISS them). The app hostnames (wandit.app, www, api) must
			// additionally get dashboard route exclusions (more-specific
			// routes assigned to Worker "None") — see
			// docs/features/edge-serving.md.
			"routes": [{ "pattern": "*/*", "zone_name": "wandit.app" }],
			"vars": { "SENTRY_ENVIRONMENT": "production" },
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			// The production pointer namespace (CLOUDFLARE_KV_NAMESPACE_ID).
			"kv_namespaces": [{ "binding": "PTR", "id": "10d1db8c7def488ba5397727c1e4ef6d" }],
			"r2_buckets": [{ "binding": "SITES", "bucket_name": "wandit-production" }],
			// The production namespace (CLOUDFLARE_W4P_NAMESPACE of the production API).
			"dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "production" }]
		},
		"staging": {
			"name": "wandit-edge-staging",
			// Test host on workers.dev, no route: a staging zone and slug host
			// are an open point for WANDIT-177.
			"workers_dev": true,
			"vars": { "SENTRY_ENVIRONMENT": "preview" },
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			// UNVERIFIED: staging may need its own namespace; replace with the
			// Railway staging CLOUDFLARE_KV_NAMESPACE_ID.
			"kv_namespaces": [{ "binding": "PTR", "id": "10d1db8c7def488ba5397727c1e4ef6d" }],
			"r2_buckets": [{ "binding": "SITES", "bucket_name": "wandit-staging" }],
			// The staging namespace (CLOUDFLARE_W4P_NAMESPACE of the staging API).
			"dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "staging" }]
		}
	}
}
