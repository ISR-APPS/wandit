{
	"name": "server",
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"dev": "tsx watch src/main.ts",
		"start": "node dist/main.mjs",
		"test": "vitest run",
		"stripe:listen": "stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed,charge.refunded,charge.dispute.created --forward-to localhost:3000/api/webhooks/stripe",
		"stripe:seed": "tsx scripts/seed-stripe.ts"
	},
	"dependencies": {
		"@fastify/multipart": "^10.0.0",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/platform-fastify": "^11.1.27",
		"@opentelemetry/api": "^1.9.1",
		"@wandit/auth": "workspace:*",
		"@wandit/contracts": "workspace:*",
		"@wandit/db": "workspace:*",
		"@wandit/env": "workspace:*",
		"@wandit/jobs": "workspace:*",
		"ai": "^7.0.14",
		"bullmq": "^5.79.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"fastify": "^5.9.0",
		"ioredis": "^5.11.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"stripe": "^20.4.1"
	},
	"devDependencies": {
		"@types/node": "^22.20.0",
		"@wandit/config": "workspace:*",
		"tsdown": "^0.21.10",
		"tsx": "^4.22.4",
		"typescript": "catalog:",
		"vitest": "^4.1.9"
	}
}
