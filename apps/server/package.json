{
	"name": "server",
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"build": "tsdown",
		"billing:assert-zero-live-subs": "tsx scripts/assert-zero-live-subscriptions.ts",
		"check-types": "tsc -b",
		"dev": "tsx watch src/main.ts",
		"dev:trigger": "npx trigger.dev@4.5.3 dev",
		"mcp:seed": "tsx scripts/seed-mcp-connectors.ts",
		"start": "node --enable-source-maps --import ./dist/instrument.mjs dist/main.mjs",
		"test": "vitest run",
		"stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.upcoming,invoice.payment_failed,payment_intent.succeeded,payment_intent.payment_failed,payment_intent.canceled,charge.refunded,charge.refund.updated,refund.updated,refund.failed,charge.dispute.created,charge.dispute.closed --forward-to localhost:${PORT:-3000}/api/webhooks/stripe",
		"stripe:seed": "tsx scripts/seed-stripe.ts"
	},
	"dependencies": {
		"@ai-sdk/gateway": "4.0.11",
		"@ai-sdk/mcp": "2.0.10",
		"@aws-sdk/client-s3": "^3.1085.0",
		"@fastify/multipart": "^10.0.0",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/platform-fastify": "^11.1.27",
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@opentelemetry/api": "^1.9.1",
		"@sentry/nestjs": "catalog:",
		"@sentry/node": "catalog:",
		"@trigger.dev/sdk": "4.5.3",
		"@wandit/analytics": "workspace:*",
		"@wandit/auth": "workspace:*",
		"@wandit/contracts": "workspace:*",
		"@wandit/db": "workspace:*",
		"@wandit/env": "workspace:*",
		"@wandit/jobs": "workspace:*",
		"@wandit/observability": "workspace:*",
		"ai": "^7.0.14",
		"better-auth": "catalog:",
		"bullmq": "^5.79.2",
		"cheerio": "^1.2.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"disposable-email-domains": "^1.0.62",
		"exceljs": "^4.4.0",
		"fastify": "^5.9.0",
		"ioredis": "^5.11.1",
		"mammoth": "^1.12.0",
		"playwright": "1.61.1",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.18.1",
		"rxjs": "^7.8.2",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.3",
		"stripe": "^20.4.1",
		"undici": "^8.8.0",
		"unpdf": "^1.8.0"
	},
	"devDependencies": {
		"@ai-sdk/provider": "^4.0.3",
		"@sentry/esbuild-plugin": "catalog:",
		"@trigger.dev/build": "4.5.3",
		"@types/node": "^22.20.0",
		"@types/sanitize-html": "^2.16.1",
		"@wandit/config": "workspace:*",
		"gsap": "3.12.5",
		"tsdown": "^0.21.10",
		"tsx": "^4.22.4",
		"typescript": "catalog:",
		"vitest": "^4.1.9"
	}
}
