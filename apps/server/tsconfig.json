{
	"extends": "@wandit/config/tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"outDir": "dist",
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "react-jsx"
	},
	// wandit-kit is a read-only reference folder, not part of the build.
	"exclude": ["dist", "node_modules", "wandit-kit"]
}
