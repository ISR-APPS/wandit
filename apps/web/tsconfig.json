{
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"rootDirs": ["."],
		"paths": {
			"@/*": ["./src/*"],
			"@wandit/internationalization": [
				"../../packages/internationalization/src/index.ts"
			],
			"@wandit/internationalization/*": [
				"../../packages/internationalization/src/*"
			],
			"@wandit/ui/*": ["../../packages/ui/src/*"]
		}
	}
}
