{
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"rootDirs": ["."],
		"paths": {
			"@/*": ["./src/*"],
			"@wandit/internationalization": [
				"../../packages/internationalization/src/index.ts"
			],
			"@wandit/internationalization/*": [
				"../../packages/internationalization/src/*"
			],
			"@wandit/ui/*": ["../../packages/ui/src/*"],
			// lib/wandit-source.spec.ts imports the Vite plugin of the web template.
			// The template has no node_modules in CI, so its `vite` is this one.
			"vite": ["./node_modules/vite/dist/node/index.d.ts"]
		}
	}
}
