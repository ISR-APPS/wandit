{
	"expo": {
		"scheme": "wandit",
		"userInterfaceStyle": "automatic",
		"orientation": "default",
		"web": {
			"bundler": "metro"
		},
		"name": "wandit",
		"slug": "wandit",
		"plugins": [
			"expo-font",
			[
				"expo-audio",
				{
					"microphonePermission": "Allow Wandit to use your microphone for voice input.",
					"recordAudioAndroid": true
				}
			],
			"expo-sharing",
			"expo-video"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"ios": {
			"bundleIdentifier": "com.zakisb97.wandit"
		}
	}
}
