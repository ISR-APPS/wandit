{
	"name": "wandit",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"dev:pipeline": "turbo run dev dev:trigger -F server -F web",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native",
		"dev:web": "turbo run dev -F web",
		"dev:server": "turbo run dev -F server",
		"dev:worker": "turbo run dev -F worker",
		"db:push": "turbo run db:push -F @wandit/db",
		"db:studio": "turbo run db:studio -F @wandit/db",
		"db:generate": "turbo run db:generate -F @wandit/db",
		"db:migrate": "turbo run db:migrate -F @wandit/db",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@wandit/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@wandit/config": "workspace:*",
		"@types/node": "^22.13.14",
		"turbo": "^2.9.16",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@11.7.0"
}
