{
  "name": "my-better-t-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "dev:worker": "turbo run dev -F worker",
    "db:push": "turbo run db:push -F @my-better-t-app/db",
    "db:studio": "turbo run db:studio -F @my-better-t-app/db",
    "db:generate": "turbo run db:generate -F @my-better-t-app/db",
    "db:migrate": "turbo run db:migrate -F @my-better-t-app/db",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@my-better-t-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@my-better-t-app/config": "workspace:*",
    "@types/node": "^22.13.14",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}
